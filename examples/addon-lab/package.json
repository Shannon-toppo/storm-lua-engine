{
  "name": "@stormcat-works/addon-lab-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three.jsとCodeMirrorでAddonのTSホスト実装を試すブラウザサンプル",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare:engine": "node scripts/prepare-engine.mjs && node scripts/licenses.mjs",
    "dev": "npm run prepare:engine && vite --host 0.0.0.0",
    "build": "npm run prepare:engine && tsc --noEmit && vite build && node ../../tools/check-artifacts.mjs dist",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/test-browser.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "codemirror": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/theme-one-dark": "6.1.3",
    "@stormcat-works/storm-lua-engine": "file:../../packages/lua-engine"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "@types/node": "22.15.30",
    "playwright": "1.62.1"
  }
}
